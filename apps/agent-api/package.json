{
  "name": "@fieldai/agent-api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "start:field-events": "node dist/field-event-worker.js",
    "start:retention": "node dist/retention-purge-worker.js",
    "revocation:checkpoint": "node dist/revocation-checkpoint-cli.js --quiesced",
    "revocation:restore": "node dist/revocation-restore-cli.js --offline-restored",
    "retention:checkpoint": "node dist/retention-checkpoint-cli.js --quiesced",
    "retention:restore": "node dist/retention-restore-cli.js --offline-restored",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:unit": "tsx --test test/health.test.ts test/billing-period.test.ts test/toss-billing.adapter.test.ts test/notification-delivery.adapter.test.ts test/toss-billing-refund.adapter.test.ts",
    "start:billing-authorization": "node dist/billing-authorization-worker.js",
    "start:billing-charge": "node dist/billing-charge-worker.js",
    "start:notifications": "node dist/notification-delivery-worker.js",
    "start:billing-refund": "node dist/billing-refund-worker.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1139.0",
    "@better-auth/oauth-provider": "1.7.5",
    "better-auth": "1.7.5",
    "fastify": "5.12.5",
    "pg": "8.23.0",
    "sharp": "0.35.4",
    "web-push": "3.6.7"
  },
  "devDependencies": {
    "@types/web-push": "3.6.4"
  }
}
