{
  "name": "@fieldai/field-api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "start:ap-events": "node dist/ap-event-worker.js",
    "worker": "node dist/worker.js",
    "worker:retention": "node dist/retention-purge-worker.js",
    "restore:retention": "node dist/retention-restore-cli.js",
    "checkpoint:retention": "node dist/retention-checkpoint-cli.js",
    "restore:revocations": "node dist/revocation-restore-cli.js",
    "checkpoint:revocations": "node dist/revocation-checkpoint-cli.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:unit": "tsx --test test/health.test.ts test/billing-period.test.ts test/toss-billing.adapter.test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1139.0",
    "@better-auth/oauth-provider": "1.7.5",
    "better-auth": "1.7.5",
    "fastify": "5.12.5",
    "iovalkey": "0.4.0",
    "pg": "8.23.0",
    "sharp": "0.35.4"
  }
}
