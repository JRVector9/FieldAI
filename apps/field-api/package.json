{
  "name": "@fieldai/field-api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "start:ap-events": "node dist/ap-event-worker.js",
    "worker": "node dist/worker.js",
    "worker:retention": "node dist/retention-purge-worker.js",
    "restore:retention": "node dist/retention-restore-cli.js",
    "checkpoint:retention": "node dist/retention-checkpoint-cli.js",
    "restore:revocations": "node dist/revocation-restore-cli.js",
    "checkpoint:revocations": "node dist/revocation-checkpoint-cli.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:unit": "tsx --test test/health.test.ts test/billing-period.test.ts test/toss-billing.adapter.test.ts test/notification-delivery.adapter.test.ts test/ap-public-write-client.test.ts test/custom-domain-dns.test.ts",
    "start:billing-authorization": "node dist/billing-authorization-worker.js",
    "start:billing-charge": "node dist/billing-charge-worker.js",
    "start:notifications": "node dist/notification-delivery-worker.js",
    "start:custom-domain": "node dist/custom-domain-worker.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1139.0",
    "@better-auth/oauth-provider": "1.7.5",
    "better-auth": "1.7.5",
    "fastify": "5.12.5",
    "iovalkey": "0.4.0",
    "pg": "8.23.0",
    "sharp": "0.35.4",
    "web-push": "3.6.7"
  },
  "devDependencies": {
    "@types/web-push": "3.6.4"
  }
}
