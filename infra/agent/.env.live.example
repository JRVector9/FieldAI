# AP(Agent Platform) 운영 환경 예시 — 실제 값은 저장소 밖 secret 관리 도구에 두고 infra/agent/.env.live(git 무시)로 배포한다.
# Field 값(FIELD_*)은 넣지 않는다(B01). 이 파일은 compose의 ${...} 치환(--env-file)과 앱 env_file 양쪽에 쓰인다.
#
# 표기: [부팅]               비면 compose 또는 앱이 시작을 거부한다.
#       [blocked_integration] 비면 해당 기능만 blocked_integration(미연결)로 닫히고 나머지는 동작한다.
#       [정책]               승인된 운영 정책 값. 비면 해당 기능이 닫힌다.
# 주의: 숫자 한도 항목은 빈 값(KEY=)이면 0 또는 잘못된 값으로 해석된다. 기본값을 쓸 때는 주석으로 남겨 둔다.
# 주의: NEXT_PUBLIC_* 는 web 빌드 시 인라인된다. 빈 값 대신 주석으로 두어야 앱의 "미설정" 표시가 나온다.

# ── compose·DB ─────────────────────────────────────────────
# [부팅] AP 전용 PostgreSQL 비밀번호(URL에 그대로 들어가므로 영숫자/base64url 권장). compose가 AP_DATABASE_URL을 만든다.
AP_DB_PASSWORD=
# 외부 관리형 DB를 쓸 때만 지정. 지정하면 compose의 기본 주소(db 서비스) 대신 사용한다.
# AP_DATABASE_URL=
# 이미지 이름·태그(레지스트리 사용 시). 기본값은 로컬 빌드 태그 fieldai-agent-*:local.
# AP_API_IMAGE=
# AP_WEB_IMAGE=
# AP_MIGRATE_IMAGE=
# 호스트 127.0.0.1에 노출할 포트(edge가 이 포트로 프록시). 기본 4311/3001.
# AP_API_PORT=4311
# AP_WEB_PORT=3001
# compose 내부 네트워크 대역. 기본 172.31.11.0/24. 바꾸면 AP_TRUST_PROXY 기본값도 같이 바뀐다.
# AP_NETWORK_SUBNET=172.31.11.0/24
# 앱 컨테이너가 읽을 env 파일 경로(compose 파일 기준). 기본 .env.live.
# AP_ENV_FILE=

# ── 로그·요청 제한 ─────────────────────────────────────────
# 구조화 로그 수준(fatal·error·warn·info·debug·trace·silent). 기본 info. 그 밖의 값이면 부팅 거부(docs/04 5.6.1).
# AP_LOG_LEVEL=info
# API 요청 1건의 최대 처리 시간(밀리초, Fastify requestTimeout). 느린 본문으로 연결을 붙잡는 요청을 끊는다. 바꿀 때만 주석 해제.
# AP_REQUEST_TIMEOUT_MS=30000

# ── compose가 고정하는 값(여기에 써도 덮어쓴다) ───────────────
# NODE_ENV=production, AP_PROFILE=live, AP_HOST=0.0.0.0, AP_PORT=4311,
# AP_REVOCATION_JOURNAL_DIRECTORY·AP_RETENTION_JOURNAL_DIRECTORY=/var/lib/fieldai/agent/*-journal(볼륨)
# X-Forwarded-For를 신뢰할 프록시 대역(쉼표 구분 IP/CIDR). 기본은 compose 네트워크 대역. edge가 다른 대역이면 지정.
# AP_TRUST_PROXY=

# ── 인증·공개 주소 ─────────────────────────────────────────
# [부팅] Better Auth 서명 비밀값(32바이트 이상 무작위).
AP_AUTH_SECRET=
# [부팅] AP API의 공개 https 주소(OAuth issuer·콜백 기준). 예: https://api.agent.example.com
AP_AUTH_BASE_URL=
# [부팅] AP 웹의 공개 https origin(로그인·동의 화면, 상담 iframe 이동). 예: https://agent.example.com
AP_PUBLIC_WEB_ORIGIN=

# ── 메일(가입 확인·비밀번호 재설정) ─────────────────────────
# [blocked_integration] SMTP 주소. live는 smtps:// 만 허용. 둘 중 하나만 있으면 부팅 거부.
AP_SMTP_URL=
# [blocked_integration] 발신 주소. 예: Agent Platform <no-reply@agent.example.com>
AP_MAIL_FROM=

# ── 카카오 로그인(제품별 카카오 앱) ───────────────────────────
# [blocked_integration] 둘 다 비우면 카카오 버튼은 비활성, 하나만 있으면 부팅 거부. mock에는 넣을 수 없다.
# 카카오 콘솔 Redirect URI: <AP_PUBLIC_WEB_ORIGIN>/api/auth/callback/kakao, 동의 항목: 카카오계정(이메일)·닉네임.
AP_KAKAO_CLIENT_ID=
AP_KAKAO_CLIENT_SECRET=

# ── 체험 정책 ──────────────────────────────────────────────
# [정책] 승인된 체험 동의 문구 버전(최대 100자). 비면 체험 시작이 닫힌다.
AP_TRIAL_CONSENT_VERSION=
# [정책] 체험 기간(1~90일 정수). 비면 체험 시작이 닫힌다.
AP_TRIAL_DAYS=

# ── AI 모델 ────────────────────────────────────────────────
# [blocked_integration] AP 상담 AI용 OpenAI API 키.
AP_OPENAI_API_KEY=
# [blocked_integration] AP 상담 AI 모델 이름.
AP_OPENAI_MODEL=
# [정책] 조직별 고객 AI 상담 일일 한도(1~100000). 비면 무료 체험 조직의 고객 AI 상담이 budget_not_configured.
AP_CUSTOMER_DAILY_LIMIT=
# [정책] 조직별 홍보 카드 경유 문의 일일 한도(1~100000). 비면 홍보 경유 접수가 budget_not_configured.
AP_PLACEMENT_ENGAGEMENT_DAILY_LIMIT=
# 사업자 AI 테스트 일일 한도. 기본 20. 빈 값은 0이 되므로 바꿀 때만 주석 해제.
# AP_TEST_DAILY_LIMIT=20
# 공개 문의 신규 접수 조직 전체 15분 상한(1~1000). 기본 60. 빈 값은 부팅 후 접수 오류.
# AP_PUBLIC_SUBMISSION_ORG_LIMIT=60
# Field 연결 업무 사전 확인 조직별 한도(1~1000). 기본 120. 빈 값은 오류.
# AP_FIELD_PREFLIGHT_ORG_LIMIT=120

# ── 비공개 문의 사진 저장소(S3 호환) ────────────────────────
# [blocked_integration] 네 값이 모두 있어야 사진 첨부가 열린다.
# 비어 있어도 retention worker(기본 서비스)는 기동해 계정·조직 삭제와 outbox·웹훅 정리를 계속한다.
# 다만 문의 사진 파일 삭제 단계는 blocked_integration으로 남아 실행되지 않는다.
AP_INQUIRY_S3_BUCKET=
AP_INQUIRY_S3_REGION=
AP_INQUIRY_S3_ACCESS_KEY_ID=
AP_INQUIRY_S3_SECRET_ACCESS_KEY=
# S3 호환 공급사(AWS 외)의 endpoint. AWS S3면 비워 둔다.
AP_INQUIRY_S3_ENDPOINT=
# mock 전용 로컬 사진 디렉터리. live에서는 사용하지 않는다.
# AP_INQUIRY_MEDIA_DIRECTORY=

# ── 서명 저널 키(볼륨의 저널과 짝; 분실 시 기존 저널을 읽을 수 없음) ──
# [blocked_integration] OAuth 토큰 회수·연결 수명주기 저널 HMAC 키. 비면 공개 OAuth 연결 제공이 닫힌다.
AP_REVOCATION_JOURNAL_SECRET=
# [부팅] 보존기간 삭제 저널 HMAC 키. 비면 retention worker(기본 서비스)가 시작을 거부해 계정·조직 삭제와 정리 작업이 멈춘다.
AP_RETENTION_JOURNAL_SECRET=

# ── Field 연결(선택, AP 단독 운영에는 불필요) ────────────────
# [blocked_integration] 네 값은 모두 있거나 모두 없어야 한다. 모두 https 필수.
# Field OAuth issuer 주소(Field API 공개 주소).
AP_FIELD_OAUTH_ISSUER=
# Field에 등록한 AP client ID.
AP_FIELD_CLIENT_ID=
# Field에 등록한 AP client secret.
AP_FIELD_CLIENT_SECRET=
# 연결 토큰 암호화 키(32바이트 base64url).
AP_FIELD_TOKEN_KEY=

# ── 구독 결제(토스페이먼츠) ─────────────────────────────────
# [blocked_integration] 네 값은 모두 있거나 모두 없어야 한다.
AP_TOSS_CLIENT_KEY=
AP_TOSS_SECRET_KEY=
# 토스 상점 ID.
AP_TOSS_MID=
# 결제 수단 자격증명 암호화 키(32바이트 base64url, 43자).
AP_BILLING_CREDENTIAL_KEY=
# Toss 힌트 수신 IPv4·IPv6 /64별 15분 한도(1~100000 정수, 기본 120).
# 정상 피크·공급사 재전송량을 측정해 필요할 때 명시 상향한다. 실제 청구 결과는 공급사 조회로 대조한다.
# AP_BILLING_WEBHOOK_IP_LIMIT=120

# ── 알림(솔라피 카카오/문자, 웹 푸시) ────────────────────────
# [blocked_integration] 알림 자격증명 암호화 키(32바이트 base64url, 43자). 비어 있는데 SOLAPI/PUSH 값이 있으면 부팅 거부.
AP_NOTIFICATION_CREDENTIAL_KEY=
# 문자·카카오 공급사 계약 승인 여부. 승인 후에만 true.
AP_NOTIFICATION_PROVIDER_APPROVED=
AP_SOLAPI_ACCOUNT_ID=
AP_SOLAPI_API_KEY=
AP_SOLAPI_API_SECRET=
# 발신 번호(0으로 시작하는 9~11자리).
AP_SOLAPI_FROM=
# 카카오 비즈 채널 PF ID.
AP_SOLAPI_PF_ID=
# 사업자·고객 알림 템플릿 ID.
AP_SOLAPI_OWNER_TEMPLATE_ID=
AP_SOLAPI_CUSTOMER_TEMPLATE_ID=
# 발송 결과 콜백 검증 비밀값(32자 이상).
AP_SOLAPI_CALLBACK_SECRET=
# 웹 푸시 공급 승인 여부. 승인 후에만 true.
AP_PUSH_PROVIDER_APPROVED=
# VAPID subject(mailto:주소)와 키 쌍(base64url).
AP_PUSH_VAPID_SUBJECT=
AP_PUSH_VAPID_PUBLIC_KEY=
AP_PUSH_VAPID_PRIVATE_KEY=

# ── web 빌드 인자(빌드 시 인라인; 값을 정할 때만 주석 해제) ─────
# Field 제품 홈으로 가는 이동 링크(세션 공유 아님). 미설정 시 앱 기본값(로컬 주소)이 들어가므로 live에서는 지정 권장.
# NEXT_PUBLIC_FIELD_WEB_URL=
# 법적 고지(상호·대표자·사업자등록번호·통신판매업 신고번호·주소·연락 이메일·개인정보 보호책임자). 미설정이면 "미설정"으로 표시.
# NEXT_PUBLIC_LEGAL_BUSINESS_NAME=
# NEXT_PUBLIC_LEGAL_REPRESENTATIVE=
# NEXT_PUBLIC_LEGAL_REGISTRATION_NUMBER=
# NEXT_PUBLIC_LEGAL_MAIL_ORDER_NUMBER=
# NEXT_PUBLIC_LEGAL_ADDRESS=
# NEXT_PUBLIC_LEGAL_CONTACT_EMAIL=
# NEXT_PUBLIC_LEGAL_PRIVACY_OFFICER=
# APP_PROFILE=live, AP_API_BASE_URL=http://api:4311 은 compose가 고정한다.

# ── 오프라인 복구·체크포인트 CLI 전용(상시 서비스에 넣지 않음) ───
# AP_OAUTH_LIFECYCLE_CHECKPOINT_FILE / AP_OAUTH_LIFECYCLE_CHECKPOINT_OUTPUT / AP_OAUTH_LIFECYCLE_RESTORE_DATABASE_URL
# AP_REVOCATION_CHECKPOINT_OUTPUT / AP_REVOCATION_RESTORE_CHECKPOINT_FILE / AP_REVOCATION_RESTORE_DATABASE_URL
# AP_RETENTION_CHECKPOINT_OUTPUT / AP_RETENTION_RESTORE_CHECKPOINT_FILE / AP_RETENTION_RESTORE_DATABASE_URL / AP_RETENTION_RESTORE_MEDIA_DIRECTORY
# AP_ACCOUNT_DELETION_CHECKPOINT_OUTPUT / AP_ACCOUNT_DELETION_RESTORE_CHECKPOINT_FILE
# 계정·조직 삭제 저널은 AP_RETENTION_JOURNAL_DIRECTORY/account-deletion에서 같은 SECRET의 별도 HMAC 용도로 서명한다.

# [정책] Field→AP 서명 사건 v1(접두사·버전 헤더 없음) 수용 여부. live 기본 false, 전환 기간에만 true
# AP_EVENT_SIGNATURE_ACCEPT_V1=false
# [정책] AP→Field 발신 서명 버전(1|2). 기본 2. 구버전 Field 수신자와 섞이는 전환 기간에만 1
# AP_EVENT_SIGNATURE_SEND_VERSION=2
