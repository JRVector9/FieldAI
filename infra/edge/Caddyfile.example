# Edge(TLS 종료) 예시 — Caddy 2. AP와 Field upstream을 섞지 않는다.
#
# 전제
# - 각 제품 compose(infra/<product>/compose.live.yaml)가 api/web을 호스트 127.0.0.1에만 노출한다.
#   AP: web 127.0.0.1:3001, api 127.0.0.1:4311 / Field: web 127.0.0.1:3002, api 127.0.0.1:4321
# - Caddy는 같은 호스트에서 실행한다(패키지 설치 또는 network_mode: host 컨테이너).
#   AP와 Field를 서로 다른 서버에 배포하면 각 서버의 Caddyfile에는 자기 제품 블록만 남긴다.
# - 호스트 이름은 환경변수로 넣는다(Caddy가 기동 시 {$VAR}를 치환).
#   ACME_EMAIL, AP_WEB_HOST, AP_API_HOST, FIELD_WEB_HOST, FIELD_API_HOST, FIELD_SITE_BASE_DOMAIN, CLOUDFLARE_API_TOKEN
#   값 목록 예시: infra/edge/.env.example (caddy run --envfile 로 넘길 수 있다)
#
# X-Forwarded-For
# - 앱은 *_TRUST_PROXY 대역(기본: 각 compose 네트워크 대역)에서 온 XFF만 신뢰해 고객 IP를 구한다.
#   공개 접수 IP 한도가 이 값에 의존하므로 edge는 반드시 XFF를 실제 접속 IP로 다시 써야 한다.
# - Caddy reverse_proxy 기본 동작: trusted_proxies가 비어 있으면 클라이언트가 보낸 X-Forwarded-For를
#   버리고 실제 접속 IP로 새로 설정한다(X-Forwarded-Proto/Host도 설정). 그래서 header_up을 따로 두지 않는다.
#   Caddy 앞에 CDN/로드밸런서가 있으면 전역 servers { trusted_proxies static <대역> }에 그 대역만 넣는다.
#   임의 대역(0.0.0.0/0)을 신뢰하면 고객이 XFF를 위조해 IP 한도를 우회할 수 있다.
# - Host 헤더는 그대로 전달한다(Field web이 Host로 플랫폼/테넌트 사이트를 구분).
#
# 와일드카드 테넌트 도메인(*.{$FIELD_SITE_BASE_DOMAIN})
# - 와일드카드 인증서는 ACME DNS-01 챌린지만 가능하다. DNS 공급사 모듈을 포함해 Caddy를 빌드해야 한다.
#   예: xcaddy build --with github.com/caddy-dns/cloudflare
#   아래 `dns cloudflare` 줄을 실제 DNS 공급사 모듈·토큰 환경변수로 바꾼다. 기본 Caddy 바이너리로는 이 파일이 로드되지 않는다.
# - DNS에는 *.{$FIELD_SITE_BASE_DOMAIN} → 이 서버 A/AAAA 레코드가 필요하다.

{
	email {$ACME_EMAIL}
	# 사업자 자체 도메인 인증서는 처음 접속할 때 발급한다(on-demand TLS).
	# Caddy가 발급 전에 GET <ask>?domain=<host>를 호출하고 200일 때만 발급한다.
	# Field API는 소유권 TXT·라우팅 DNS가 검증된 활성 도메인(상태 tls_pending/connected)에만 200을 준다.
	# Field API가 다른 서버에 있으면 그 내부 주소로 바꾸되 공개 인터넷에 노출하지 않는다.
	on_demand_tls {
		ask http://127.0.0.1:4321/v1/public/site-hosts/allow
	}
}

# ───────────── AP(Agent Platform) ─────────────
{$AP_WEB_HOST} {
	encode zstd gzip
	reverse_proxy 127.0.0.1:3001
}

# 외부 사이트 SDK·위젯·공개 API·OAuth issuer
{$AP_API_HOST} {
	encode zstd gzip
	reverse_proxy 127.0.0.1:4311
}

# ───────────── Field ─────────────
{$FIELD_WEB_HOST} {
	encode zstd gzip
	reverse_proxy 127.0.0.1:3002
}

{$FIELD_API_HOST} {
	encode zstd gzip
	reverse_proxy 127.0.0.1:4321
}

# 테넌트 기본 사이트 주소 field-<id>.{$FIELD_SITE_BASE_DOMAIN} → Field web(Host로 사이트 판별)
*.{$FIELD_SITE_BASE_DOMAIN} {
	tls {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
	}
	encode zstd gzip
	reverse_proxy 127.0.0.1:3002
}

# 사업자 자체 도메인(shop.example.co.kr 등) → Field web(Host로 사이트 판별)
# - 위에 명시한 호스트·와일드카드에 해당하지 않는 HTTPS 요청만 이 블록으로 온다.
# - 인증서는 on_demand_tls ask가 허용한 도메인에만 발급된다. 등록만 했거나 DNS 확인 전·연결 해제된 도메인은 거부된다.
# - X-Forwarded-For는 위 "X-Forwarded-For" 설명대로 reverse_proxy 기본 동작이 실제 접속 IP로 다시 쓴다.
#   Field web은 이 값을 그대로 API로 넘기고 API는 *_TRUST_PROXY 대역만 신뢰한다.
# - 주의: Field 도메인 상태가 connected가 되려면 인증서·바인딩을 확인해 주는 edge 어댑터(DomainEdgeProvider)가
#   Field API에 연결되어야 한다. 어댑터가 없으면 도메인은 blocked_integration에 머물고 ask도 거부한다(발급 안 함).
# - Caddy edge 어댑터(추가): Field API·도메인 작업자에 FIELD_DOMAIN_EDGE=caddy(선택 FIELD_DOMAIN_EDGE_PROBE_TIMEOUT_MS, 기본 5000)를
#   설정하면 작업자가 https://<도메인>/.well-known/field-site-health 를 SNI로 요청해 공인 체인 인증서(자체 서명 거절)와
#   응답 proof(서버 비밀값 HMAC(도메인:조직))가 도메인 행과 맞는지 확인한 뒤에만 connected로 바꾼다. 첫 요청이 on-demand 발급을 시작한다.
#   이 경로만 Host를 유지한 채 Field API로 보낸다(아래 handle). API는 ask와 같은 조건(tls_pending·connected·TLS 실패 error)에만 200을 준다.
#   확인 실패는 tls_pending에서 처음 실패한 때부터 15분 동안 tls_pending, 그 뒤 error(domain_tls_failed)로 기록하고
#   확인이 성공할 때까지 error를 유지하며 계속 다시 시도한다.
#   작업자에서 이 서버의 공인 주소로 HTTPS(443) 접속이 가능해야 한다(같은 호스트면 hairpin 접속 허용 필요).
https:// {
	tls {
		on_demand
	}
	encode zstd gzip
	handle /.well-known/field-site-health {
		reverse_proxy 127.0.0.1:4321
	}
	handle {
		reverse_proxy 127.0.0.1:3002
	}
}
