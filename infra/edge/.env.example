# Edge(Caddy) 환경 예시 — infra/edge/Caddyfile.example의 {$VAR}/{env.VAR} 치환 값.
# 실제 값은 저장소 밖에 두고 `caddy run --config Caddyfile --envfile <이 파일의 사본>` 또는 서비스 환경변수로 넣는다.
# 앱 비밀값(AP_*·FIELD_* 인증·DB·공급사 키)은 넣지 않는다. 이 파일에는 공개 호스트 이름과 ACME·DNS 값만 둔다.
# AP와 Field를 서로 다른 서버에 배포하면 각 서버에는 자기 제품 호스트만 남긴다.

# ACME(Let's Encrypt 등) 계정 이메일
ACME_EMAIL=
# AP 웹·API 공개 호스트(스킴 없이). 예: agent.example.com / api.agent.example.com
AP_WEB_HOST=
AP_API_HOST=
# Field 웹·API 공개 호스트(스킴 없이). 예: field.example.com / api.field.example.com
FIELD_WEB_HOST=
FIELD_API_HOST=
# 테넌트 기본 사이트 도메인. Field의 FIELD_SITE_BASE_DOMAIN과 같은 값. 예: sites.example.com
FIELD_SITE_BASE_DOMAIN=
# 와일드카드 인증서 DNS-01 챌린지용 DNS 공급사 토큰(예시는 Cloudflare 모듈). 다른 공급사면 Caddyfile의 dns 줄과 함께 바꾼다.
CLOUDFLARE_API_TOKEN=
