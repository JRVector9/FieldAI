{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "action_request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "connection_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "kind": {
      "enum": [
        "inquiry",
        "reservation_request"
      ]
    },
    "origin_conversation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "external_service_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "expected_service_revision": {
      "type": "integer",
      "minimum": 1
    },
    "customer": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "phone": {
          "type": "string",
          "pattern": "^01[0-9]{8,9}$"
        },
        "verified": {
          "const": false
        }
      },
      "required": [
        "name",
        "phone",
        "verified"
      ]
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": [
            "inquiry",
            "preferred",
            "slot"
          ]
        },
        "timezone": {
          "const": "Asia/Seoul"
        },
        "preferences": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "type": "string",
            "maxLength": 160
          }
        },
        "start_at": {
          "type": "string",
          "format": "date-time"
        },
        "end_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "mode",
        "timezone"
      ]
    },
    "consent": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "record_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "confirmed_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "version",
        "record_id",
        "confirmed_at"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "attachment_refs": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160,
        "pattern": "^[A-Za-z0-9_.:-]+$"
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "provider": {
          "const": "agent-platform"
        },
        "deployment_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "is_test": {
          "type": "boolean"
        }
      },
      "required": [
        "provider",
        "deployment_id",
        "is_test"
      ]
    }
  },
  "required": [
    "action_request_id",
    "connection_id",
    "kind",
    "origin_conversation_id",
    "customer",
    "request",
    "consent",
    "summary",
    "attachment_refs",
    "source"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "reservation_request"
          }
        }
      },
      "then": {
        "required": [
          "external_service_id",
          "expected_service_revision"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "request": {
            "properties": {
              "mode": {
                "const": "slot"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "request": {
            "required": [
              "start_at",
              "end_at"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "request": {
            "properties": {
              "mode": {
                "const": "preferred"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "request": {
            "required": [
              "preferences"
            ],
            "properties": {
              "preferences": {
                "minItems": 1
              }
            }
          }
        }
      }
    }
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "action_request contract design v1.0"
}