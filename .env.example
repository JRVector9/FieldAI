# 각 제품의 실제 값은 별도 secret manager/환경에 보관한다.
# mock DB는 `node tools/setup-mock-env.mjs`가 infra/<product>/.env에 생성한다.
AP_DATABASE_URL=
AP_AUTH_BASE_URL=
# `mock`는 로컬 spike에만 사용하고 production 빌드/프로세스에서는 거부한다.
AP_PROFILE=
AP_INQUIRY_MEDIA_DIRECTORY=
AP_INQUIRY_S3_BUCKET=
AP_INQUIRY_S3_REGION=
AP_INQUIRY_S3_ACCESS_KEY_ID=
AP_INQUIRY_S3_SECRET_ACCESS_KEY=
AP_INQUIRY_S3_ENDPOINT=
FIELD_PROFILE=
AP_PORT=4311
AP_HOST=127.0.0.1
FIELD_DATABASE_URL=
FIELD_AUTH_BASE_URL=
FIELD_VALKEY_URL=
FIELD_MEDIA_DIRECTORY=
FIELD_INQUIRY_MEDIA_DIRECTORY=
FIELD_S3_BUCKET=
FIELD_S3_REGION=
FIELD_S3_ACCESS_KEY_ID=
FIELD_S3_SECRET_ACCESS_KEY=
FIELD_S3_ENDPOINT=
FIELD_INQUIRY_S3_BUCKET=
FIELD_INQUIRY_S3_REGION=
FIELD_INQUIRY_S3_ACCESS_KEY_ID=
FIELD_INQUIRY_S3_SECRET_ACCESS_KEY=
FIELD_INQUIRY_S3_ENDPOINT=
FIELD_PORT=4321
FIELD_HOST=127.0.0.1
AP_API_BASE_URL=http://127.0.0.1:4311
# 운영 iframe이 AP 1차 상담 화면으로 이동할 공개 https origin. mock은 localhost:3001 기본값.
AP_PUBLIC_WEB_ORIGIN=
FIELD_API_BASE_URL=http://127.0.0.1:4321

# 웹 화면 검토본. APP_PROFILE=live 빌드/기동은 차단한다.
# 두 주소는 독립 제품 간 명시적 이동 링크일 뿐 세션이나 API 호출을 공유하지 않는다.
APP_PROFILE=design_preview
NEXT_PUBLIC_AGENT_WEB_URL=http://localhost:3001
NEXT_PUBLIC_FIELD_WEB_URL=http://localhost:3002

# 외부 연동 준비 시 제품별로 독립 설정한다. 미설정이면 해당 기능은 blocked_integration.
AP_AUTH_SECRET=
FIELD_AUTH_SECRET=
# 제품별 공개 문의/예약 신규 접수의 조직 전체 15분 상한(기본 60, 허용 1~1000).
AP_PUBLIC_SUBMISSION_ORG_LIMIT=60
FIELD_PUBLIC_SUBMISSION_ORG_LIMIT=60
AP_KAKAO_CLIENT_ID=
AP_KAKAO_CLIENT_SECRET=
FIELD_KAKAO_CLIENT_ID=
FIELD_KAKAO_CLIENT_SECRET=
AP_OPENAI_API_KEY=
AP_OPENAI_MODEL=
AP_TEST_DAILY_LIMIT=20
AP_CUSTOMER_DAILY_LIMIT=
FIELD_OPENAI_API_KEY=
FIELD_OPENAI_MODEL=
AP_OBJECT_BUCKET=
FIELD_OBJECT_BUCKET=
